{
  "manifest_version": 3,
  "name": "trust0",
  "version": "0.1.0",
  "description": "Checks AI answers, posts, videos and articles as you browse and tags them with a trust verdict and score.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "trust0",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/shared.js",
        "src/content/sites.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
