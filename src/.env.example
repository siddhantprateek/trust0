# Copy to .env and fill in what you have. Every key is optional: a stage whose key is missing is
# skipped and the report says so, rather than the whole check failing.

# Which backend does claim extraction, fact checking and provenance research: anthropic (default), openai, or
# openrouter. Only the keys for the one you pick need to be set.
LLM_PROVIDER=anthropic

# anthropic: Claude, with its own web_search + web_fetch tools (claude.py).
ANTHROPIC_API_KEY=

# openai: OpenAI direct, via the Responses API with OpenAI's hosted web_search tool.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1

# openrouter: one key reaches whatever model you name (e.g. anthropic/claude-sonnet-4.5, openai/gpt-5.1,
# google/gemini-3-pro — see openrouter.ai/models). Web search comes from OpenRouter's own "web" plugin.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# SerpAPI (Google Lens): reverse image search on thumbnails/keyframes to find earlier uploads.
SERPAPI_API_KEY=

# Google Fact Check Tools: matches claims against published fact checks (free key from Google Cloud).
GOOGLE_FACTCHECK_API_KEY=

# Hive: AI-generated image/video detection on keyframes (thehive.ai, "AI-Generated Content Detection").
HIVE_API_KEY=

# TypeSafe Jev (console.typesafe.ai/keys). Three small decisions, each falling back to the old behaviour without a key:
# the lean of outlets missing from the curated table, which news results are on the story, and a visual second
# opinion on keyframes before media is called AI-generated. See docs/jev.md.
TYPESAFE_API_KEY=
# Pinned to Jev 1.14.0 so answers stay stable; jev-preview / jev-latest are moving aliases
# (images are a TypeSafe preview feature; they work on 1.13 too)
JEV_MODEL=jev-1.14.0
# Outlets Jev is less sure about than this stay unrated (0-1)
JEV_MIN_CONFIDENCE=0.5
# Ask Jev's image model for a second opinion on keyframes (four image requests per check)
JEV_VISUAL_REVIEW=true

# t0-vision, our own AI-image detector (experiments/ai-detect). Runs locally; needs the [local] extra.
# With this set, a Hive key is optional.
T0_VISION_MODEL_PATH=C:/trust0-data/checkpoints/t0-vision/best

# Speech-to-text for videos with no captions (local Whisper, [local] extra). Empty turns it off.
WHISPER_MODEL=openai/whisper-large-v3-turbo

# Where local models run: auto (GPU if available), cuda or cpu. Use cpu while training on the GPU.
LOCAL_DEVICE=auto

# Netscape-format cookies file for yt-dlp. Instagram, Facebook and some X posts need a logged-in session.
YTDLP_COOKIES_FILE=

# Where the SQLite database and downloaded media live.
DATA_DIR=./data

# Origins allowed to call the API (comma-separated). The extension is always allowed.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://studio.trytrust0.online

# Base URL of the studio, used to build report links returned to the extension.
STUDIO_URL=https://studio.trytrust0.online

# Try IPv4 first. Set to true if checks hang on networks with broken IPv6.
PREFER_IPV4=false

# Reddit app-only OAuth (create a "script" app at reddit.com/prefs/apps). Reddit blocks anonymous API requests.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Keep each checked image/video so the studio can show it full size (stored in DATA_DIR/previews)
KEEP_MEDIA=true
